# Client ID público de Google OAuth (no es un secreto: viaja siempre al cliente).
# Si se omite, se usa el valor por defecto definido en src/lib/config.ts.
PUBLIC_GOOGLE_CLIENT_ID=622196535234-ddrlisjppqaivef385ncm17jvi22pojk.apps.googleusercontent.com

# Origen público de la app. Es OPCIONAL: si no se define, se usa el origen real
# del navegador (local, deploy preview o producción). No lo fijes a producción
# en local: los enlaces de invitación apuntarían allí.
# PUBLIC_SITE_URL=https://mialbumweb.netlify.app

# Clave pública de la API de Google (solo si usas el Picker). Restríngela por referrer.
