---
import Base from "../layouts/Base.astro";
import Contenedor from "../components/layout/Contenedor.astro";
---

<Base titulo="Página no encontrada" noindex>
  <Contenedor estrecho class="grid min-h-[60vh] place-items-center py-16 text-center">
    <div class="anim-subir flex flex-col items-center">
      <span
        class="bg-gradient-to-br from-primario to-primario-2 bg-clip-text text-7xl font-extrabold text-transparent sm:text-8xl"
      >
        404
      </span>
      <h1 class="mt-4 text-2xl font-extrabold tracking-tight sm:text-3xl">
        Esta página no existe
      </h1>
      <p class="mt-2 max-w-sm text-sm text-suave">
        Puede que el enlace esté mal escrito o que la página se haya movido.
      </p>

      <div class="mt-7 flex flex-col gap-2 sm:flex-row">
        <a href="/" class="btn btn-prim">Volver al inicio</a>
        <a href="/album.html" class="btn btn-sec">Ir a mi álbum</a>
      </div>
    </div>
  </Contenedor>
</Base>
