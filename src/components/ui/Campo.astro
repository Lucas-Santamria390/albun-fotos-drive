---
type TipoEntrada =
  | "text"
  | "email"
  | "password"
  | "search"
  | "tel"
  | "url"
  | "number"
  | "date"
  | "time"
  | "datetime-local"
  | "month"
  | "week"
  | "checkbox"
  | "radio"
  | "file";

interface Props {
  id: string;
  etiqueta: string;
  tipo?: TipoEntrada;
  valor?: string;
  nombre?: string;
  marcador?: string;
  requerido?: boolean;
  ayuda?: string;
  error?: string;
  autocompletar?: string;
  min?: string;
  max?: string;
}

const {
  id,
  etiqueta,
  tipo = "text",
  valor,
  nombre,
  marcador,
  requerido = false,
  ayuda,
  error,
  autocompletar,
  min,
  max,
} = Astro.props;

const descrito = [ayuda ? `${id}-ayuda` : "", error ? `${id}-error` : ""].filter(Boolean).join(" ");
---

<div class="flex flex-col gap-1.5">
  <label for={id} class="text-xs font-semibold text-suave">{etiqueta}</label>
  <input
    id={id}
    name={nombre ?? id}
    type={tipo}
    value={valor}
    placeholder={marcador}
    required={requerido}
    autocomplete={autocompletar}
    min={min}
    max={max}
    aria-describedby={descrito || undefined}
    aria-invalid={error ? "true" : undefined}
    class:list={["campo", error && "border-peligro focus:border-peligro"]}
  />
  {ayuda && <p id={`${id}-ayuda`} class="text-xs text-suave">{ayuda}</p>}
  {error && (
    <p id={`${id}-error`} class="text-xs font-semibold text-peligro" role="alert">
      {error}
    </p>
  )}
</div>
