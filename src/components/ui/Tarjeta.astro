---
interface Props {
  class?: string;
  interactiva?: boolean;
}

const { class: claseExtra = "", interactiva = false } = Astro.props;
---

<div
  class:list={[
    "tarjeta p-5 sm:p-6",
    interactiva &&
      "transition-transform duration-200 hover:-translate-y-0.5 hover:shadow-lg focus-within:shadow-lg",
    claseExtra,
  ]}
>
  <slot />
</div>
