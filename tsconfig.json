{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": false,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"]
  }
}
